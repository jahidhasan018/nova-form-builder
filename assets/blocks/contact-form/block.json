{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "nova-form-builder/contact-form",
  "version": "1.0.0",
  "title": "Nova Contact Form",
  "category": "widgets",
  "icon": "email",
  "description": "Dynamic contact form with secure REST submission handling.",
  "textdomain": "nova-form-builder",
  "attributes": {
    "formTitle": {
      "type": "string",
      "default": "Contact Us"
    },
    "submitLabel": {
      "type": "string",
      "default": "Send Message"
    }
  },
  "supports": {
    "html": false
  },
  "editorScript": "file:./build/index.js"
}
